{
    "name": "secalyzer/secalyzer",
    "description": "Scans PHP CMS plugins, themes and web apps for vulnerabilities with static rules plus optional AI-powered analysis.",
    "license": "MIT",
    "type": "library",
    "keywords": ["security", "scanner", "static-analysis", "vulnerability", "cms", "php", "xss", "sqli"],
    "authors": [
        {
            "name": "Secalyzer Team"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/console": "^6.0",
        "nikic/php-parser": "^4.15",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "bin": [
        "bin/secalyzer"
    ],
    "autoload": {
        "psr-4": {
            "Src\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
